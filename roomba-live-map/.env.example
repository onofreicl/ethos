# Copy this file to `.env` and fill in the values printed by
# `npm run credentials`.

# Robot identity (from the credential extraction step)
ROOMBA_BLID=
ROOMBA_PASSWORD=
ROOMBA_IP=

# Web server
PORT=3000

# Set to 1 to run a simulated robot instead of connecting to hardware.
# Useful for developing the UI without a Roomba on the LAN.
MOCK=0
